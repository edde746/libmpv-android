+// Classic gralloc YUV format ('YV12' fourcc); universally accepted by
+// SurfaceFlinger video planes long before it appeared in any NDK header.
+#define ANDROID_HAL_PIXEL_FORMAT_YV12 0x32315659
+
+// ANativeWindow_setBuffersDataSpace is API 28+; resolved at runtime so the
+// minSdk 25 (Fire OS 6) build keeps loading. Values from android/data_space.h.
+#define ANDROID_DATASPACE_BT709     281083904
+#define ANDROID_DATASPACE_BT601_625 281149440
+#define ANDROID_DATASPACE_BT601_525 281280512
+
+static void sw_set_dataspace(struct vo *vo, ANativeWindow *win,
+                             struct mp_image_params *params)
+{
+    static int32_t (*set_dataspace)(ANativeWindow *, int32_t);
+    static bool resolved;
+    if (!resolved) {
+        // API 28+, and it lives in libnativewindow.so, which nothing else in
+        // this process is guaranteed to have loaded - dlopen it explicitly.
+        void *lib = dlopen("libnativewindow.so", RTLD_NOW | RTLD_GLOBAL);
+        if (lib)
+            set_dataspace = dlsym(lib, "ANativeWindow_setBuffersDataSpace");
+        resolved = true;
+    }
+    if (!set_dataspace)
+        return;
+
+    int32_t ds;
+    switch (params->color.primaries) {
+    case PL_COLOR_PRIM_BT_601_525: ds = ANDROID_DATASPACE_BT601_525; break;
+    case PL_COLOR_PRIM_BT_601_625: ds = ANDROID_DATASPACE_BT601_625; break;
+    case PL_COLOR_PRIM_BT_709:     ds = ANDROID_DATASPACE_BT709;     break;
+    default:
+        ds = params->h >= 720 ? ANDROID_DATASPACE_BT709
+                              : ANDROID_DATASPACE_BT601_625;
+        break;
+    }
+    set_dataspace(win, ds);
+}
