+static void copy_plane(uint8_t *dst, ptrdiff_t dst_stride,
+                       const uint8_t *src, ptrdiff_t src_stride,
+                       size_t bytes, int h)
+{
+    for (int y = 0; y < h; y++) {
+        memcpy(dst, src, bytes);
+        dst += dst_stride;
+        src += src_stride;
+    }
+}
+
+static bool sw_copy_yv12(struct ANativeWindow_Buffer *buf, struct mp_image *img)
+{
+    int w = MPMIN(img->w, buf->width);
+    int h = MPMIN(img->h, buf->height);
+    int cw = (w + 1) / 2, ch = (h + 1) / 2;
+    // YV12: full-height Y plane, then Cr, then Cb; chroma stride is the Y
+    // stride halved and aligned up to 16.
+    ptrdiff_t ystride = buf->stride;
+    ptrdiff_t cstride = MP_ALIGN_UP(ystride / 2, 16);
+    uint8_t *dst_y = buf->bits;
+    uint8_t *dst_cr = dst_y + ystride * buf->height;
+    uint8_t *dst_cb = dst_cr + cstride * ((buf->height + 1) / 2);
+
+    copy_plane(dst_y, ystride, img->planes[0], img->stride[0], w, h);
+    copy_plane(dst_cr, cstride, img->planes[2], img->stride[2], cw, ch);
+    copy_plane(dst_cb, cstride, img->planes[1], img->stride[1], cw, ch);
+    return true;
+}
+
+static bool sw_copy_rgbx(struct vo *vo, struct ANativeWindow_Buffer *buf,
+                         struct mp_image *img)
+{
+    struct priv *p = vo->priv;
+    if (!p->sws)
+        p->sws = mp_sws_alloc(vo);
+    if (!p->sws)
+        return false;
+
+    struct mp_image dst = {0};
+    mp_image_setfmt(&dst, IMGFMT_RGB0);
+    mp_image_set_size(&dst, buf->width, buf->height);
+    dst.planes[0] = buf->bits;
+    dst.stride[0] = buf->stride * 4;
+    dst.params.repr.levels = PL_COLOR_LEVELS_FULL;
+    return mp_sws_scale(p->sws, &dst, img) >= 0;
+}
+
+static void sw_present(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    ANativeWindow *win = p->video_window;
+    struct ANativeWindow_Buffer buf;
+
+    if (!win)
+        return;
+
+    if (ANativeWindow_lock(win, &buf, NULL) != 0) {
+        if (p->sw_use_yv12) {
+            // Device gralloc rejected YV12; fall back to RGBX + swscale.
+            p->sw_use_yv12 = false;
+            ANativeWindow_setBuffersGeometry(win, p->cur_image->w,
+                                             p->cur_image->h,
+                                             WINDOW_FORMAT_RGBX_8888);
+            if (ANativeWindow_lock(win, &buf, NULL) != 0)
+                goto error;
+        } else {
+            goto error;
+        }
+    }
+
+    bool ok = false;
+    switch (buf.format) {
+    case ANDROID_HAL_PIXEL_FORMAT_YV12:
+        ok = sw_copy_yv12(&buf, p->cur_image);
+        break;
+    case WINDOW_FORMAT_RGBX_8888:
+    case WINDOW_FORMAT_RGBA_8888:
+        ok = sw_copy_rgbx(vo, &buf, p->cur_image);
+        break;
+    }
+    ANativeWindow_unlockAndPost(win);
+    if (ok)
+        return;
+
+error:
+    if (!p->sw_error_logged) {
+        MP_ERR(vo, "Failed to render software frame to the video Surface.\n");
+        p->sw_error_logged = true;
+    }
+}
